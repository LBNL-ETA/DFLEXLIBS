siteRef: @site
---
// A chiller submeter. Its equip has no `siteMeter` tag, so the PBui filter's
// equipRef->siteMeter traversal must not pick this up as building demand.
id: @submeter
dis: "Chiller Submeter"
equip
elec
meter
submeter
siteRef: @site
---
id: @chillerPower
dis: "Chiller Power"
point
sensor
elec
power
kind: "Number"
unit: "kW"
equipRef: @submeter
siteRef: @site
