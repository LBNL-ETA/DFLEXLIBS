@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix constraint: <https://nrel.gov/BuildingMOTIF/constraints#> .
@prefix : <urn:kpi__cumulative_average_thermal_discomfort/> .

: a owl:Ontology ;
    owl:imports <https://brickschema.org/schema/1.3/Brick> .

:zone_air-temperature-sensor a sh:NodeShape ;
    sh:targetNode : ;
    constraint:minCount 1 ;
    constraint:class brick:Zone_Air_Temperature_Sensor .

:zone_air-temperature-sensor-timeseries-identifier a sh:NodeShape ;
    sh:targetClass brick:Zone_Air_Temperature_Sensor;
    sh:property [
		sh:path ref:hasExternalReference ; 
        sh:minCount 1;
		sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ref:hasTimeseriesId ; 
            sh:minCount 1;
            sh:maxCount 1;
            sh:datatype xsd:string ;
        ] ;	
    ] ;
.

:min_air-temperature-setpoint a sh:NodeShape ;
    sh:targetNode : ;
    constraint:minCount 1 ;
    constraint:class brick:Min_Air_Temperature_Setpoint .

:min_air-temperature-setpoint-timeseries-identifier a sh:NodeShape ;
    sh:targetClass brick:Min_Air_Temperature_Setpoint;
    sh:property [
		sh:path ref:hasExternalReference ; 
        sh:minCount 1;
		sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ref:hasTimeseriesId ; 
            sh:minCount 1;
            sh:maxCount 1;
            sh:datatype xsd:string ;
        ] ;	
    ] ;
.

:max_air-temperature-setpoint a sh:NodeShape ;
    sh:targetNode : ;
    constraint:minCount 1 ;
    constraint:class brick:Zone_Air_Temperature_Sensor .

:max_air-temperature-setpoint-timeseries-identifier a sh:NodeShape ;
    sh:targetClass brick:Max_Air_Temperature_Setpoint;
    sh:property [
		sh:path ref:hasExternalReference ; 
        sh:minCount 1;
		sh:nodeKind sh:BlankNode ;
        sh:property [
            sh:path ref:hasTimeseriesId ; 
            sh:minCount 1;
            sh:maxCount 1;
            sh:datatype xsd:string ;
        ] ;	
    ] ;
.
